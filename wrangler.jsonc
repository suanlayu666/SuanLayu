{
  "name": "suanlayu",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/guestbook"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GUESTBOOK_DATA", "class_name": "GuestbookData" }]
  },
  "migrations": [{ "tag": "guestbook-v1", "new_sqlite_classes": ["GuestbookData"] }],
  "ratelimits": [
    { "name": "GUESTBOOK_RATE_LIMIT", "namespace_id": "1011", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "GUESTBOOK_ORIGINS": "https://suanlayu-zv00buod.edgeone.cool"
  }
}
